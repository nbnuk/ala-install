[
  {
    "name": "Add to map",
    "width": 110,
    "items": [
      {
        "name": "Species",
        "open": "ToolAddSpeciesService"
      },
      {
        "name": "Area",
        "open": "addArea"
      },
      {
        "name": "Layer",
        "open": "ToolAddLayerService"
      },
      {
        "name": "Facet",
        "open": "ToolAddFacetService"
      }
    ]
  },
  {
    "name": "Tools",
    "width": 70,
    "items": [
      {
        "name": "Area Report - interactive",
        "open": "ToolAreaReportService"
      },
      {
        "name": "Area Report - PDF",
        "open": "AreaReport"
      },
      {
        "name": "Tabulate - 1D",
        "open": "SpeciesByLayer"
      },
      {
        "name": "Taxon Frequency",
        "open": "TaxonFrequency"
      },
      {
        "name": "Compare Areas",
        "open": "CompareAreas"
      },
      {
        "name": "Points to Grid",
        "open": "PointsToGrid"
      },
      {
        "name": "Calculate AOO and EOO",
        "open": "AooEoo"
      },
      {
        "name": "Nearest Locality",
        "open": "nearestLocality"
      },
      {
        "separator": true
      },
      {
        "name": "Restore Prior Analysis",
        "open": "analysis"
      }
    ]
  },
  {
    "name": "Import",
    "width": 78,
    "items": [
      {
        "name": "Species List",
        "open": "createSpeciesList",
        "params": {
          "speciesOption": "speciesList",
          "importList": true
        }
      },
      {
        "name": "Areas",
        "open": "addArea",
        "params": {
          "importArea": true
        }
      },
      {
        "separator": true
      },
      {
        "name": "Restore prior analysis",
        "open": "analysis"
      }
    ]
  },
  {
    "name": "Export",
    "width": 77,
    "items": [
      {
        "name": "Area Checklist",
        "open": "ToolExportChecklistService"
      },
      {
        "name": "Areas",
        "open": "ToolExportAreaService"
      }
    ]
  },
  {
    "name": "Help",
    "width": 69,
    "items": {{ spatial_help_items | to_json }}
  }
]
